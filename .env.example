# MRXYZ Productions environment settings
# The site can run with local sample films before these keys are added.

# TMDB: live catalogue, search, posters and movie details
# Create a free API key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Groq: AI movie concierge chat
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional: cloud accounts and synced watchlists via Supabase
# Leave both blank to use a local browser watchlist.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: only needed if you run the Python search service separately
PYTHON_BACKEND_URL=http://127.0.0.1:8000/search
